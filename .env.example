# Copy values into your environment or GitHub Repository Secrets.
# The application does not load .env files automatically.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
WEBHOOK_URL=

# Optional Telegram notifications (both values are needed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local/runtime settings; use GitHub Repository Variables for DATA_FEED.
# SIP requires a subscription that permits recent market data; no silent fallback.
ALPACA_DATA_FEED=sip
DRY_RUN=true
# Set the GitHub Repository Variable TRADING_ENABLED=true to enable schedules.
